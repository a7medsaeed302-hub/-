# Islamic Channel Guardian - Environment Variables
# =================================================
# انسخ هذا الملف إلى .env وقم بتعديل القيم

# توكن البوت من BotFather (مطلوب)
# احصل على التوكن من @BotFather على تليجرام
BOT_TOKEN=your_bot_token_here

# معرفات المطورين (اختياري - للمراجعة البشرية)
# ضع معرفات Telegram الخاصة بالمطورين، مفصولة بفواصل
ADMIN_IDS=123456789,987654321

# مسار قاعدة البيانات (اختياري)
DATABASE_PATH=data/guardian.db

# مسار سجلات التدقيق (اختياري)
AUDIT_LOG_PATH=logs/audit.log

# مسار سجلات الأخطاء (اختياري)
ERROR_LOG_PATH=logs/error.log

# وضع التصحيح (اختياري)
# true لتفعيل رسائل تفصيلية، false للإنتاج
DEBUG_MODE=false
